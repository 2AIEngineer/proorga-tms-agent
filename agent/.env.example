# Accès au TMS via le serveur MCP
AGENT_MCP_TRANSPORT=stdio
# AGENT_MCP_URL=http://127.0.0.1:8002/mcp

# Base PostgreSQL, partagée avec le serveur MCP (qui lit mcp_server/.env).
# Schémas : agent (alertes, via MCP), monitor (état de la boucle), assistant (conversations).
POSTGRES_DB=tms_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# AGENT_STATE_DB_SCHEMA=monitor
# AGENT_ASSISTANT_DB_SCHEMA=assistant

# Boucle de surveillance
AGENT_POLL_INTERVAL_S=10
AGENT_AUTO_RESOLVE=true

# --- LLM ------------------------------------------------------------------------------
# local     : serveur compatible OpenAI hébergé en interne (vLLM) — par défaut, aucune donnée ne sort
# anthropic : API Claude (cloud) — seulement si la politique de données l'autorise
AGENT_LLM_PROVIDER=local
AGENT_LLM_ENABLED=true
AGENT_LLM_EFFORT_INVESTIGATION=high
AGENT_LLM_EFFORT_CHAT=medium
AGENT_LLM_MAX_TURNS=10

# Local (vLLM : scripts/run_vllm_container.sh)
AGENT_LOCAL_BASE_URL=http://localhost:8001/v1
AGENT_LOCAL_MODEL=Qwen/Qwen3.5-2B
AGENT_LOCAL_MAX_TOKENS=2048
AGENT_LOCAL_TEMPERATURE=0.3
# auto : raisonnement activé quand l'effort est high ou plus (enquêtes), coupé sinon
AGENT_LOCAL_THINKING=auto
# AGENT_LOCAL_CONTEXT_WINDOW=        # vide : lu sur /v1/models (max_model_len)

# Anthropic (si autorisé)
# ANTHROPIC_API_KEY=
# AGENT_ANTHROPIC_MODEL=claude-opus-5-5

# Profil d'outils : auto (compact si contexte < 32k), full, compact
AGENT_TOOLSET=auto

# Enquêtes automatiques (en arrière-plan : la détection n'attend jamais le LLM)
AGENT_INVESTIGATE_MIN_SEVERITY=medium
AGENT_MAX_INVESTIGATIONS_PER_CYCLE=4
AGENT_INVESTIGATION_CONCURRENCY=2
AGENT_BACKGROUND_INVESTIGATIONS=true
